# Normalise line endings so scripts written on Windows still run on Linux.
*               text=auto
*.sh            text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
*.kql           text eol=lf
*.tf            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
*.ps1           text eol=crlf
*.png           binary
*.jpg           binary
*.svg           text
